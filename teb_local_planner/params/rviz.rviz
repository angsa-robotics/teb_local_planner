Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 81
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Local Planner1
      Splitter Ratio: 0.5
    Tree Height: 562
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Splitter Ratio: 0.588679016
  - Class: rviz_common/Views
    Name: Views
    Expanded:
      - /Current View1
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Name: Time
    Experimental: false
    SyncMode: 0
    SyncSource: ""

Visualization Manager:
  Class: ""
  Enabled: true
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 1
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Plane Cell Count: 10
      Plane: XY
      Offset: {X: 0, Y: 0, Z: 0}
      Reference Frame: odom

    - Class: rviz_default_plugins/Grid
      Name: Fine Grid
      Enabled: true
      Alpha: 0.1
      Cell Size: 0.1
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Plane Cell Count: 100
      Plane: XY
      Offset: {X: 0, Y: 0, Z: 0}
      Reference Frame: odom

    - Class: rviz_common/Group
      Name: Local Planner
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Path
          Name: Path
          Enabled: true
          Topic:
            Value: /local_plan
            Depth: 5
            History Policy: Keep Last
            Reliability Policy: Reliable
            Durability Policy: Volatile
            Filter size: 10
          Color: 25; 255; 0
          Alpha: 1
          Line Style: Lines
          Line Width: 0.03
          Offset: {X: 0, Y: 0, Z: 0}
          Radius: 0.03
          Head Diameter: 0.3
          Head Length: 0.2
          Shaft Diameter: 0.1
          Shaft Length: 0.1
          Pose Style: None

        - Class: rviz_default_plugins/PoseArray
          Name: PoseArray
          Enabled: true
          Topic:
            Value: /teb_poses
            Depth: 5
            History Policy: Keep Last
            Reliability Policy: Reliable
            Durability Policy: Volatile
            Filter size: 10
          Color: 255; 25; 0
          Alpha: 1
          Shape: Arrow (Flat)
          Shaft Length: 0.23
          Shaft Radius: 0.01
          Head Length: 0.07
          Head Radius: 0.03
          Axes Length: 0.3
          Axes Radius: 0.01
          Arrow Length: 0.3

        - Class: rviz_default_plugins/Marker
          Name: Marker
          Enabled: true
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /teb_markers
          Queue Size: 100
          Namespaces:
            PointObstacles: true

        - Class: rviz_default_plugins/InteractiveMarkers
          Name: InteractiveMarkers
          Enabled: true
          Update Topic: /marker_obstacles/update
          Show Descriptions: true
          Show Axes: false
          Show Visual Aids: false
          Enable Transparency: true

  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /move_base_simple/goal
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /clicked_point
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Value: Orbit (rviz)
      Target Frame: odom
      Distance: 7.77247
      Pitch: 1.56979632
      Yaw: 4.71043873
      Focal Point: {X: 0, Y: 0, Z: 0}
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Near Clip Distance: 0.01
      Enable Stereo Rendering:
        Value: false
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false

Window Geometry:
  Width: 1354
  Height: 846
  X: 137
  Y: 50
  Displays:
    collapsed: false
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: true
  Time:
    collapsed: false
  Hide Left Dock: false
  Hide Right Dock: true
